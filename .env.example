# Neon PostgreSQL — development branch
# Get these from your Neon project dashboard → Connection Details

# Pooled connection (pgBouncer) — used by Prisma Client at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXXX-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15&pool_timeout=15"

# Direct connection — used by Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXXX.REGION.aws.neon.tech/DBNAME?sslmode=require"